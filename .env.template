# Algo_Qain environment template.
# Never commit real API keys, mnemonics, private keys, or production credentials.

ENVIRONMENT=development

# Backend Algorand Indexer configuration.
INDEXER_ADDRESS=https://testnet-algorand.api.purestake.io/idx2
INDEXER_TOKEN=YOUR_INDEXER_API_KEY_HERE
ESCROW_ADDRESS=PASTE_VALID_ALGORAND_ESCROW_ADDRESS_HERE

# Comma-separated browser origins allowed to call the backend.
# Production startup fails closed if this is empty.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional deployment tooling.
ALGOD_ADDRESS=https://testnet-algorand.api.purestake.io/ps2
ALGOD_TOKEN=YOUR_ALGOD_API_KEY_HERE

# Deployment-only secret. Use a managed secret store in hosted environments.
ADMIN_MNEMONIC=YOUR_25_WORD_TESTNET_MNEMONIC_HERE

# Frontend public configuration. Never place secret tokens in VITE_* variables.
VITE_ESCROW_ADDRESS=PASTE_ESCROW_ADDRESS_HERE
VITE_APP_ID=PASTE_APPLICATION_ID_HERE
VITE_ALGOD_ADDRESS=https://testnet-algorand.api.purestake.io/ps2
